# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI Visualization — set as Supabase secrets via:
#   supabase secrets set GEMINI_API_KEY=your-key
#   supabase secrets set HF_API_KEY=your-key
# At least one is required for AI mode in the Visualizer.
# GEMINI_API_KEY — Google AI Studio (primary, fastest)
# HF_API_KEY — HuggingFace (fallback, uses FLUX.1 Kontext via fal-ai)

# Chat-driven control planner (Admin Visualizer) — set as Supabase secrets:
#   supabase secrets set MINIMAX_API_KEY=your-key
#   supabase secrets set MINIMAX_API_BASE=https://api.minimax.chat/v1   # (optional override)
#   supabase secrets set MINIMAX_MODEL=MiniMax-Text-01                  # (optional override)
# Without MINIMAX_API_KEY the chat-to-features edge function is unavailable
# and the admin Visualizer falls back to the local regex parser.

# FaceFusion service (Railway-hosted) — set as Supabase secrets:
#   supabase secrets set FACEFUSION_URL=https://your-railway-app.up.railway.app
#   supabase secrets set FACEFUSION_API_TOKEN=<bearer token shared with Railway>
#   supabase secrets set FACEFUSION_TIMEOUT_MS=180000   # (optional, default 180s)
# Without FACEFUSION_URL the face-operation edge function returns 500 and
# face swap / enhance / age / expression operations are unavailable.
# See services/facefusion/README.md for Railway deploy steps.
